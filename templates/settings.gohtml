{{- define "settings/page" -}}
<!doctype html>
<html lang="{{ .Lang }}">
<head>
{{ template "head" . }}
</head>
<body>
  {{ template "header" . }}
  <main id="content">
    {{ template "settings/content" . }}
  </main>
  <script src="/static/js/htmx.min.js"></script>
  {{ template "sw-register" . }}
</body>
</html>
{{- end -}}

{{- define "settings/content" -}}
  <h1>{{ t "settings.heading" }}</h1>

  <section>
    <h2>{{ t "settings.profile" }}</h2>
    <p><a href="/settings/profile" hx-get="/settings/profile" hx-target="#content" hx-push-url="true">{{ t "settings.profile" }}</a></p>
  </section>

  <section>
    <h2>{{ t "settings.disliked" }}</h2>
    <p><a href="/settings/disliked" hx-get="/settings/disliked" hx-target="#content" hx-push-url="true">{{ t "settings.disliked" }}</a></p>
  </section>

  <section>
    <h2>{{ t "settings.pantry" }}</h2>
    <p><a href="/settings/pantry" hx-get="/settings/pantry" hx-target="#content" hx-push-url="true">{{ t "settings.pantry" }}</a></p>
  </section>

  <section>
    <h2>{{ t "settings.language" }}</h2>
    <form class="lang-switcher" method="post" action="/settings/language">
      <button type="submit" name="lang" value="ru">{{ t "lang.ru" }}</button>
      <button type="submit" name="lang" value="fi">{{ t "lang.fi" }}</button>
      <button type="submit" name="lang" value="en">{{ t "lang.en" }}</button>
    </form>
  </section>
{{- end -}}
