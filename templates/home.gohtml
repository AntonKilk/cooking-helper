{{- define "home/page" -}}
<!doctype html>
<html lang="{{ .Lang }}">
<head>
{{ template "head" . }}
</head>
<body>
  {{ template "header" . }}
  <main id="content">
    {{ template "home/content" . }}
  </main>
  <script src="/static/js/htmx.min.js"></script>
  {{ template "sw-register" . }}
</body>
</html>
{{- end -}}

{{- define "home/content" -}}
  <h1>{{ t "home.heading" }}</h1>
  <p>{{ t "home.subtitle" }}</p>

  <section class="generate">
    {{- if .CanGenerate }}
    <button type="button" class="generate__button"
            hx-post="/generate" hx-target="#week" hx-indicator="#generate-indicator">
      {{ t "home.generate" }}
    </button>
    <p id="generate-indicator" class="generate__indicator htmx-indicator">{{ t "home.generating" }}</p>
    {{- else }}
    <button type="button" class="generate__button" disabled aria-disabled="true">
      {{ t "home.generate" }}
    </button>
    <p class="generate__hint">{{ t "home.generate_disabled" }}</p>
    {{- end }}
  </section>

  <section id="week" class="week" aria-live="polite"></section>

  <section class="home-shopping">
    <a href="/shopping" hx-get="/shopping" hx-target="#content" hx-push-url="true" class="home-shopping__link">{{ t "nav.shopping" }}</a>
  </section>
{{- end -}}
