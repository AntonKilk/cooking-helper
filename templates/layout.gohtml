{{- define "layout" -}}
<!doctype html>
<html lang="{{ .Lang }}">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ t "app.title" }}</title>
</head>
<body>
  <h1>{{ t "app.title" }}</h1>

  <section>
    <h2>{{ t "shopping.categories_heading" }}</h2>
    <ul>
      {{- range .CategoryKeys }}
      <li>{{ t . }}</li>
      {{- end }}
    </ul>
  </section>

  <section>
    <h2>{{ t "settings.language" }}</h2>
    <form method="post" action="/settings/language">
      <button type="submit" name="lang" value="ru">{{ t "lang.ru" }}</button>
      <button type="submit" name="lang" value="fi">{{ t "lang.fi" }}</button>
      <button type="submit" name="lang" value="en">{{ t "lang.en" }}</button>
    </form>
  </section>
</body>
</html>
{{- end -}}
